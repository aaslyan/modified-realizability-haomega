/-!
# The Closed Numerical Universe ($\mathcal{U}_{\mathbb{Q}}$): System T Jet Functionals & Master Closure

This module formalizes the **Minimum Viable Closed Numerical Function Universe ($\mathcal{U}_{\mathbb{Q}}$)**
in $\mathrm{HA}^\omega$, uniting three levels of constructive mathematical analysis:

1. **Higher-Type Calculus Functionals in Gödel's System T (`tmJetAdd`, `tmJetDeriv`, `tmJetInteg`)**:
   Representing a function by its rational Taylor-jet stream `JetTy := .arrow .nat .rat` ($n \mapsto c_n$),
   addition $\mathcal{A}$, subtraction $\mathcal{S}$, differentiation $\mathcal{D}$, and integration $\mathcal{I}$
   are **closed Type-2 System T combinators**:
   - $\mathcal{D} = \lambda c\, n.\; \mathrm{qnat}(n+1) \cdot_{\mathbb{Q}} c(n+1)$ (Order-0, recursion-free, lookahead $+1$)
   - $\mathcal{I} = \lambda c\, n.\; \mathrm{recNat}\; 0_{\mathbb{Q}}\; (\lambda k\, \_.\; c(k) /_{\mathbb{Q}} \mathrm{qnat}(k+1))\; n$ (strictly causal, lookahead $-1$)

2. **Newton–Leibniz (FTC1) as Object-Language $\beta\iota$-Reduction in `Deriv` (`jetFTC1_beta_iota_D`, `ftcAntiderivD`)**:
   Inside `Deriv`, using **only System T's $\beta$ and `recNat`-$\iota$ rules (`convBeta` + `convRecSucc`)**,
   $(\mathcal{D}(\mathcal{I}\,c))(n)$ reduces syntactically to $(n+1) \cdot \frac{c(n)}{n+1}$.
   Extracting from the antiderivative existence proof `ftcAntiderivD` via `extractClosed` yields
   the executable System T integration functional `extractedJetInteg`.

3. **Order-0 System T Streams for $\exp$, $\sin$, $\cos$ (`tmExpJet`, `tmSinJet`, `tmCosJet`)**:
   Demonstrates the computer-science complexity hierarchy ($\mathcal{F}_2$): $\exp$, $\sin$, and $\cos$
   are generated by **Order-0 `recNat`** (state type `.rat` or `.prod .rat .rat`, no arrow types in recursion),
   running in linear $O(n)$ steps.

4. **The Cauchy-Majorized Closed Universe (`Jet`, `AnalyticJet`) & Master Closure Theorem**:
   Equips rational streams with the factorial-scaled Cauchy majorant $|c_n| \cdot n! \le 2^M \cdot (2^R)^n$
   and proves that $\mathcal{U}_{\mathbb{Q}}$ contains $\mathbb{Q}[x], \exp, \sin, \cos$ and is **strictly closed**
   under $+, -, \mathcal{D}, \mathcal{I}$ without ever losing smoothness:
   - $\mathcal{D} : (M, R) \mapsto (M + R, R)$ (`AnalyticJet.deriv`)
   - $\mathcal{I} : (M, R) \mapsto (M, R)$ (`AnalyticJet.integ`)
   - Exact FTC1 (`Jet.deriv_integ_val`), FTC2 (`Jet.integ_deriv_coeff_succ`), and ODE laws
     ($\mathcal{D}\exp = \exp$, $\mathcal{D}\sin = \cos$, $\mathcal{D}\cos = -\sin$).
-/

namespace HAomega

open Rat

/-! ## 1. Higher-Type Calculus Functionals in Gödel's System T -/

/-- The System T type of a rational coefficient stream (Taylor jet): `nat → rat`. -/
abbrev JetTy : Ty := .arrow .nat .rat

/-- Open System T derivative of jet `c` at index `n`: `(n + 1) * c(n + 1)`.
    Notice that differentiation requires **zero recursion** (`recNat`-free) and has lookahead $+1$. -/
def jetDerivAt {Γ : List Ty} (c : Tm Γ JetTy) (n : Tm Γ .nat) : Tm Γ .rat :=
  .qmul (.qnat (.succ n)) (.app c (.succ n))

/-- Step functional for System T jet integration:
    `λ (k : nat) (acc : rat). c(k) / (k + 1)`.
    To compute coefficient $k + 1$, it queries $c$ only at index $k$ (lookahead $-1$, strictly causal). -/
def jetIntegStep {Γ : List Ty} (c : Tm Γ JetTy) :
    Tm Γ (.arrow .nat (.arrow .rat .rat)) :=
  .lam (.lam (.qdiv (.app ((c.wk (σ := .nat)).wk (σ := .rat)) (.var (.there .here)))
                    (.qnat (.succ (.var (.there .here))))))

/-- Open System T integral of jet `c` at index `n`:
    `recNat 0 (λ k _. c(k) / (k + 1)) n`. -/
def jetIntegAt {Γ : List Ty} (c : Tm Γ JetTy) (n : Tm Γ .nat) : Tm Γ .rat :=
  .recNat (.qnat .zero) (jetIntegStep c) n

/-- Closed Type-2 System T Jet Addition functional: `λ c1 c2 n. c1(n) + c2(n)`. -/
def tmJetAdd {Γ : List Ty} : Tm Γ (.arrow JetTy (.arrow JetTy JetTy)) :=
  .lam (.lam (.lam (
    .qadd (.app (.var (.there (.there .here))) (.var .here))
          (.app (.var (.there .here)) (.var .here))
  )))

/-- Closed Type-2 System T Jet Subtraction functional: `λ c1 c2 n. c1(n) - c2(n)`. -/
def tmJetSub {Γ : List Ty} : Tm Γ (.arrow JetTy (.arrow JetTy JetTy)) :=
  .lam (.lam (.lam (
    .qsub (.app (.var (.there (.there .here))) (.var .here))
          (.app (.var (.there .here)) (.var .here))
  )))

/-- Closed Type-2 System T Jet Differentiation functional $\mathcal{D}$:
    `λ c n. (n + 1) * c(n + 1)`. -/
def tmJetDeriv {Γ : List Ty} : Tm Γ (.arrow JetTy JetTy) :=
  .lam (.lam (jetDerivAt (.var (.there .here)) (.var .here)))

/-- Closed Type-2 System T Jet Integration functional $\mathcal{I}$:
    `λ c n. recNat 0 (λ k _. c(k) / (k + 1)) n`. -/
def tmJetInteg {Γ : List Ty} : Tm Γ (.arrow JetTy JetTy) :=
  .lam (.lam (jetIntegAt (.var (.there .here)) (.var .here)))

/-! ## 2. Newton–Leibniz (FTC1) as $\beta\iota$-Reduction Inside `Deriv` -/

theorem linkJetIntegStep1 {Γ : List Ty} (c : Tm Γ JetTy) (n : Tm Γ .nat) :
    Tm.subst1 (.lam (.qdiv (.app ((c.wk (σ := .nat)).wk (σ := .rat)) (.var (.there .here)))
                           (.qnat (.succ (.var (.there .here))))) : Tm (.nat :: Γ) (.arrow .rat .rat)) n
      = .lam (.qdiv (.app (c.wk (σ := .rat)) n.wk) (.qnat (.succ n.wk))) := by
  simp only [Tm.subst1, Tm.subst, Sub.ext, Sub.one, Tm.wk_subst_ext, Tm.wk_subst_one]
  rfl

theorem linkJetIntegStep2 {Γ : List Ty} (c : Tm Γ JetTy) (n : Tm Γ .nat) (acc : Tm Γ .rat) :
    Tm.subst1 (.qdiv (.app (c.wk (σ := .rat)) n.wk) (.qnat (.succ n.wk)) : Tm (.rat :: Γ) .rat) acc
      = .qdiv (.app c n) (.qnat (.succ n)) := by
  simp only [Tm.subst1, Tm.subst, Tm.wk_subst_one]

/-- Right-factor congruence for `.qmul` inside `Deriv`. -/
def qmulCongRight {Γ as : List Ty} {Δ : Ctx Γ as} (a : Tm Γ .rat) {b1 b2 : Tm Γ .rat}
    (hb : Deriv Δ (.eq b1 b2)) :
    Deriv Δ (.eq (.qmul a b1) (.qmul a b2)) := by
  have hRefl : Deriv Δ (.eq (.qmul a b1) (.qmul a b1)) := Deriv.eqRefl (.qmul a b1)
  have h1 : Deriv Δ ((Formula.eq (.qmul a.wk b1.wk) (.qmul a.wk (.var .here))).subst1 b1) := by
    simpa [Formula.subst1, Formula.subst, Tm.subst, Sub.one, Tm.wk_subst_one] using hRefl
  have h2 := Deriv.eqSubst (φ := .eq (.qmul a.wk b1.wk) (.qmul a.wk (.var .here))) hb h1
  simpa [Formula.subst1, Formula.subst, Tm.subst, Sub.one, Tm.wk_subst_one] using h2

/-- Beta-reduction of `jetIntegStep c` applied to `n` and `acc` inside `Deriv`. -/
def jetIntegStepAppD {Γ as : List Ty} {Δ : Ctx Γ as} (c : Tm Γ JetTy) (n : Tm Γ .nat) (acc : Tm Γ .rat) :
    Deriv Δ (.eq (.app (.app (jetIntegStep c) n) acc) (.qdiv (.app c n) (.qnat (.succ n)))) := by
  have h1 : Deriv Δ (.eq (.app (jetIntegStep c) n)
      (.lam (.qdiv (.app (c.wk (σ := .rat)) n.wk) (.qnat (.succ n.wk))))) := by
    have h := Deriv.convBeta (Δ := Δ) (c := .nat)
      (.lam (.qdiv (.app ((c.wk (σ := .nat)).wk (σ := .rat)) (.var (.there .here)))
                   (.qnat (.succ (.var (.there .here))))) : Tm (.nat :: Γ) (.arrow .rat .rat)) n
    rwa [linkJetIntegStep1] at h
  have h2 : Deriv Δ (.eq (.app (.lam (.qdiv (.app (c.wk (σ := .rat)) n.wk) (.qnat (.succ n.wk)))) acc)
      (.qdiv (.app c n) (.qnat (.succ n)))) := by
    have h := Deriv.convBeta (Δ := Δ) (c := .rat)
      (.qdiv (.app (c.wk (σ := .rat)) n.wk) (.qnat (.succ n.wk)) : Tm (.rat :: Γ) .rat) acc
    rwa [linkJetIntegStep2] at h
  exact Deriv.transE (Deriv.congFun h1 acc) h2

/-- Base equation in `Deriv`: $(\mathcal{I}\,c)(0) = 0$ via `convRecZero`. -/
def jetIntegZeroD {Γ as : List Ty} {Δ : Ctx Γ as} (c : Tm Γ JetTy) :
    Deriv Δ (.eq (jetIntegAt c .zero) (.qnat .zero)) :=
  Deriv.convRecZero (.qnat .zero) (jetIntegStep c)

/-- Step equation in `Deriv`: $(\mathcal{I}\,c)(n + 1) = c(n) / (n + 1)$ via `convRecSucc` + `convBeta`. -/
def jetIntegSuccD {Γ as : List Ty} {Δ : Ctx Γ as} (c : Tm Γ JetTy) (n : Tm Γ .nat) :
    Deriv Δ (.eq (jetIntegAt c (.succ n)) (.qdiv (.app c n) (.qnat (.succ n)))) :=
  Deriv.transE (Deriv.convRecSucc (.qnat .zero) (jetIntegStep c) n)
    (jetIntegStepAppD c n (jetIntegAt c n))

/-- **Theorem (Object-Language $\beta\iota$-Reduction of FTC1 in `Deriv`)**:
    Inside $\mathrm{HA}^\omega$'s natural deduction system `Deriv`, the $n$-th coefficient of the
    derivative of the integral of `c`, namely $(n+1) \cdot (\mathcal{I}\,c)(n+1)$, reduces
    **purely by System T's $\beta$ and `recNat`-$\iota$ rules** to $(n+1) \cdot (c(n) / (n+1))$. -/
def jetFTC1_beta_iota_D {Γ as : List Ty} {Δ : Ctx Γ as} (c : Tm Γ JetTy) (n : Tm Γ .nat) :
    Deriv Δ (.eq (.qmul (.qnat (.succ n)) (jetIntegAt c (.succ n)))
                 (.qmul (.qnat (.succ n)) (.qdiv (.app c n) (.qnat (.succ n))))) :=
  qmulCongRight (.qnat (.succ n)) (jetIntegSuccD c n)

/-- Congruence for `.qsub` on the left argument (`u = u' → u - v = u' - v`). -/
def qsubCongLeft {Γ as : List Ty} {Δ : Ctx Γ as} {u u' : Tm Γ .rat} (v : Tm Γ .rat)
    (h : Deriv Δ (.eq u u')) : Deriv Δ (.eq (.qsub u v) (.qsub u' v)) := by
  have hRefl : Deriv Δ (.eq (.qsub u v) (.qsub u v)) := Deriv.eqRefl (.qsub u v)
  have h1 : Deriv Δ ((Formula.eq (.qsub u.wk v.wk) (.qsub (.var .here) v.wk)).subst1 u) := by
    simpa [Formula.subst1, Formula.subst, Tm.subst, Sub.one, Tm.wk_subst_one] using hRefl
  have h2 := Deriv.eqSubst (φ := .eq (.qsub u.wk v.wk) (.qsub (.var .here) v.wk)) h h1
  simpa [Formula.subst1, Formula.subst, Tm.subst, Sub.one, Tm.wk_subst_one] using h2

/-- **Theorem (Full Object-Language FTC1 Normalized Cancellation in `Deriv`)**:
    Composing `jetFTC1_beta_iota_D` with `convQMulDivCancel` derives inside `Deriv`
    that $(n+1) \cdot (\mathcal{I}\,c)(n+1) = c(n) + 0$.
    Note: As documented in `QArith.lean` (`Q.add_zero_not_id` and `Q.mul_div_not_id`),
    `Q` does not carry a coprimality proof, so `Q.mul` normalizes via `Q.of` just as
    `c(n) + 0` does, whereas bare `c(n)` can be unnormalized (`⟨2, 3⟩`). -/
def jetFTC1_cancel_norm_D {Γ as : List Ty} {Δ : Ctx Γ as} (c : Tm Γ JetTy) (n : Tm Γ .nat) :
    Deriv Δ (.eq (.qmul (.qnat (.succ n)) (jetIntegAt c (.succ n)))
                 (.qadd (.app c n) (.qnat .zero))) :=
  Deriv.transE (jetFTC1_beta_iota_D c n) (Deriv.convQMulDivCancel n (.app c n))

/-- **Theorem (Full Object-Language FTC1 Difference Cancellation in `Deriv`)**:
    Composing `jetFTC1_beta_iota_D` with `convQMulDivSubZero` derives inside `Deriv`
    that $((n+1) \cdot (\mathcal{I}\,c)(n+1)) - c(n) = 0$ for **every** `c : Tm Γ JetTy`! -/
def jetFTC1_sub_zero_D {Γ as : List Ty} {Δ : Ctx Γ as} (c : Tm Γ JetTy) (n : Tm Γ .nat) :
    Deriv Δ (.eq (.qsub (.qmul (.qnat (.succ n)) (jetIntegAt c (.succ n))) (.app c n))
                 (.qnat .zero)) :=
  Deriv.transE (qsubCongLeft (.app c n) (jetFTC1_beta_iota_D c n))
    (Deriv.convQMulDivSubZero n (.app c n))

/-- Formula for the Constructive Antiderivative Existence Theorem in `Deriv`:
    $\forall c : \mathrm{nat} \to \mathrm{rat}.\; \exists F : \mathrm{nat} \to \mathrm{rat}.\;
      F(0) = 0 \;\wedge\; \forall n : \mathrm{nat}.\; (n + 1) \cdot F(n + 1) = (n + 1) \cdot (c(n) / (n + 1))$. -/
abbrev ftcAntiderivFormula : Formula [] (.arrow JetTy (.prod JetTy (.prod .unit (.arrow .nat .unit)))) :=
  let F1 : Tm [JetTy, JetTy] JetTy := .var .here
  let c2 : Tm [.nat, JetTy, JetTy] JetTy := .var (.there (.there .here))
  let F2 : Tm [.nat, JetTy, JetTy] JetTy := .var (.there .here)
  let n2 : Tm [.nat, JetTy, JetTy] .nat := .var .here
  .all JetTy (.ex JetTy
    (.and (.eq (.app F1 .zero) (.qnat .zero))
          (.all .nat (.eq (jetDerivAt F2 n2)
                          (.qmul (.qnat (.succ n2)) (.qdiv (.app c2 n2) (.qnat (.succ n2))))))))

/-- **Theorem (Constructive Antiderivative Synthesis in `Deriv`)**:
    Proves in `Deriv` that every jet $c : \mathrm{nat} \to \mathrm{rat}$ has an antiderivative jet
    $F := \lambda n.\; \mathrm{jetIntegAt}\ c\ n$ satisfying $F(0) = 0$ and the $\beta\iota$-reduced
    FTC1 law $\mathcal{D}(F)(n) = (n+1) \cdot (c(n) / (n+1))$. -/
def ftcAntiderivD : Deriv Ctx.nil ftcAntiderivFormula := by
  refine Deriv.allI ?_
  let c_top : Tm [JetTy] JetTy := .var .here
  let F_witness : Tm [JetTy] JetTy := .lam (jetIntegAt c_top.wk (.var .here))
  refine Deriv.exI (τ := JetTy) F_witness ?_
  deriv_norm
  refine Deriv.andI ?_ ?_
  · -- F(0) = 0 via convBeta + convRecZero
    have hBeta0 : Deriv (Ctx.nil.wk (σ := JetTy))
        (.eq (.app F_witness .zero) (jetIntegAt c_top .zero)) := by
      have h := Deriv.convBeta (Δ := Ctx.nil.wk (σ := JetTy)) (c := .nat)
        (jetIntegAt c_top.wk (.var .here)) .zero
      simpa [Tm.subst1, Tm.subst, Sub.ext, Sub.one, jetIntegAt, jetIntegStep,
             Tm.wk_subst_ext, Tm.wk_subst_one] using h
    exact Deriv.transE hBeta0 (jetIntegZeroD c_top)
  · -- ∀ n, (n + 1) * F(n + 1) = (n + 1) * (c(n) / (n + 1)) via convBeta + jetFTC1_beta_iota_D
    refine Deriv.allI ?_
    let c_in : Tm [.nat, JetTy] JetTy := .var (.there .here)
    let n_in : Tm [.nat, JetTy] .nat := .var .here
    let F_in : Tm [.nat, JetTy] JetTy := .lam (jetIntegAt c_in.wk (.var .here))
    have hBetaSucc : Deriv ((Ctx.nil.wk (σ := JetTy)).wk (σ := .nat))
        (.eq (.app F_in (.succ n_in)) (jetIntegAt c_in (.succ n_in))) := by
      have h := Deriv.convBeta (Δ := (Ctx.nil.wk (σ := JetTy)).wk (σ := .nat)) (c := .nat)
        (jetIntegAt c_in.wk (.var .here)) (.succ n_in)
      simpa [Tm.subst1, Tm.subst, Sub.ext, Sub.one, jetIntegAt, jetIntegStep,
             Tm.wk_subst_ext, Tm.wk_subst_one] using h
    have hMul := qmulCongRight (.qnat (.succ n_in)) hBetaSucc
    exact Deriv.transE hMul (jetFTC1_beta_iota_D c_in n_in)

/-- **The extracted System T Antiderivative Functional (`extractedJetInteg`)**:
    Extracted directly via `extractClosed ftcAntiderivD`! -/
def extractedJetInteg (c : Nat → Q) : Nat → Q :=
  (((extractClosed ftcAntiderivD).eval Env.nil) c).1

/-! ## 3. Order-0 System T Streams for $\exp$, $\sin$, $\cos$ (Level $\mathcal{F}_2$ Complexity) -/

/-- Closed Order-0 System T generator for the exponential jet $c_n = 1 / n!$:
    Uses `recNat` at base type `.rat` (`acc_0 = 1`, `acc_{k+1} = acc_k / (k + 1)`).
    **Zero arrow types inside `recNat`!** -/
def tmExpJet {Γ : List Ty} : Tm Γ JetTy :=
  .lam (
    .recNat (.qnat (.succ .zero))
      (.lam (.lam (.qdiv (.var .here) (.qnat (.succ (.var (.there .here)))))))
      (.var .here)
  )

/-- Closed Order-0 System T generator for the coupled $(\sin, \cos)$ jet pair $(s_n, c_n)$:
    Uses `recNat` at base type `.prod .rat .rat` (`(0, 1)` updated by `(s, c) ↦ (c / (k+1), (0 - s) / (k+1))`).
    **Zero arrow types inside `recNat`!** -/
def tmSinCosJet {Γ : List Ty} : Tm Γ (.arrow .nat (.prod .rat .rat)) :=
  .lam (
    .recNat (.pair (.qnat .zero) (.qnat (.succ .zero)))
      (.lam (.lam (
        let sc : Tm ((.prod .rat .rat) :: .nat :: .nat :: Γ) (.prod .rat .rat) := .var .here
        let k_var : Tm ((.prod .rat .rat) :: .nat :: .nat :: Γ) .nat := .var (.there .here)
        let s_k := .fst sc
        let c_k := .snd sc
        let denom := .qnat (.succ k_var)
        .pair (.qdiv c_k denom) (.qdiv (.qsub (.qnat .zero) s_k) denom)
      )))
      (.var .here)
  )

/-- Closed Order-0 System T generator for the sine jet $\sin(x) = \sum s_n x^n$. -/
def tmSinJet {Γ : List Ty} : Tm Γ JetTy :=
  .lam (.fst (.app tmSinCosJet.wk (.var .here)))

/-- Closed Order-0 System T generator for the cosine jet $\cos(x) = \sum c_n x^n$. -/
def tmCosJet {Γ : List Ty} : Tm Γ JetTy :=
  .lam (.snd (.app tmSinCosJet.wk (.var .here)))

/-! ## 4. The Closed Differential-Integral Ring (`Jet`) & Exact FTC Theorems -/

/-- A formal rational Taylor-jet stream $F(x) = \sum_{n=0}^\infty c_n x^n$. -/
structure Jet where
  coeff : Nat → Q

namespace Jet

/-- Constant jet $q \in \mathbb{Q}$. -/
def const (q : Q) : Jet :=
  ⟨fun n ↦ match n with | 0 => q | _ + 1 => Q.zero⟩

/-- Zero jet $0$. -/
def zero : Jet := const Q.zero

/-- Identity coordinate jet $x$ ($c_1 = 1$, $c_n = 0$ for $n \ne 1$). -/
def varX : Jet :=
  ⟨fun n ↦ match n with | 1 => Q.ofNat 1 | _ => Q.zero⟩

/-- Pointwise coefficient addition $(F + G)_n = F_n + G_n$. -/
def add (F G : Jet) : Jet :=
  ⟨fun n ↦ Q.add (F.coeff n) (G.coeff n)⟩

/-- Coefficient negation $(-F)_n = -F_n$. -/
def neg (F : Jet) : Jet :=
  ⟨fun n ↦ Q.neg (F.coeff n)⟩

/-- Pointwise coefficient subtraction $(F - G)_n = F_n - G_n$. -/
def sub (F G : Jet) : Jet :=
  ⟨fun n ↦ Q.sub (F.coeff n) (G.coeff n)⟩

/-- Scalar multiplication $(q \cdot F)_n = q \cdot F_n$. -/
def scale (q : Q) (F : Jet) : Jet :=
  ⟨fun n ↦ Q.mul q (F.coeff n)⟩

/-- Formal differentiation operator $\mathcal{D}(F)_n = (n + 1) F_{n+1}$. -/
def deriv (F : Jet) : Jet :=
  ⟨fun n ↦ Q.mul (Q.ofNat (n + 1)) (F.coeff (n + 1))⟩

/-- Formal integration operator $\mathcal{I}(F)_0 = 0$, $\mathcal{I}(F)_{n+1} = F_n / (n + 1)$. -/
def integ (F : Jet) : Jet :=
  ⟨fun n ↦ match n with
    | 0 => Q.zero
    | k + 1 => Q.div (F.coeff k) (Q.ofNat (k + 1))⟩

/-- Evaluate the $N$-term polynomial truncation $\sum_{j=0}^{N-1} c_j x^j$ at $x \in \mathbb{Q}$. -/
def eval (F : Jet) (N : Nat) (x : Q) : Q :=
  sumQ (fun j ↦ Q.mul (F.coeff j) (qpow x j)) N

/-- Exponential jet $\exp(x) = \sum_{n=0}^\infty \frac{x^n}{n!}$. -/
def exp : Jet :=
  ⟨fun n ↦ Q.div (Q.ofNat 1) (Q.ofNat (fact n))⟩

/-- Coupled $(\sin, \cos)$ Taylor coefficients:
    $(0, 1), (1, 0), (0, -1/2!), (-1/3!, 0), (0, 1/4!), \dots$ -/
def sinCosCoeffs : Nat → Q × Q
  | 0 => (Q.zero, Q.ofNat 1)
  | k + 1 =>
    let (sk, ck) := sinCosCoeffs k
    (Q.div ck (Q.ofNat (k + 1)), Q.div (Q.neg sk) (Q.ofNat (k + 1)))

/-- Sine jet $\sin(x)$. -/
def sin : Jet := ⟨fun n ↦ (sinCosCoeffs n).1⟩

/-- Cosine jet $\cos(x)$. -/
def cos : Jet := ⟨fun n ↦ (sinCosCoeffs n).2⟩

/-- **Theorem (Exact FTC Part 1 on Jets: $\mathcal{D}(\mathcal{I}(F)) = F$)**:
    For every jet $F$ and every degree $n \in \mathbb{N}$,
    $$((\mathcal{D}(\mathcal{I} F)).\mathrm{coeff}\; n).\mathrm{val} = (F.\mathrm{coeff}\; n).\mathrm{val}.$$ -/
theorem deriv_integ_val (F : Jet) (n : Nat) :
    ((F.integ.deriv).coeff n).val = (F.coeff n).val := by
  dsimp [deriv, integ]
  have hn_pos : 0 < n + 1 := Nat.succ_pos n
  have hn_num : (Q.ofNat (n + 1)).num ≠ 0 := by
    unfold Q.ofNat; exact Int.ofNat_ne_zero.mpr (ne_of_gt hn_pos)
  rw [Q.val_mul, Q.val_div _ _ hn_num, Q.val_ofNat]
  have hn_rat : ((n + 1 : Nat) : Rat) ≠ 0 := by exact_mod_cast (ne_of_gt hn_pos)
  exact mul_div_cancel₀ _ hn_rat

/-- **Theorem (Exact FTC Part 2 on Jet Coefficients: $\mathcal{I}(\mathcal{D}(F)) = F - F(0)$)**:
    For every jet $F$, $(\mathcal{I}(\mathcal{D} F)).\mathrm{coeff}\; 0 = 0$ and for all $n \in \mathbb{N}$,
    $$((\mathcal{I}(\mathcal{D} F)).\mathrm{coeff}\; (n + 1)).\mathrm{val} = (F.\mathrm{coeff}\; (n + 1)).\mathrm{val}.$$ -/
theorem integ_deriv_coeff_succ (F : Jet) (n : Nat) :
    ((F.deriv.integ).coeff 0).val = 0 ∧
    ((F.deriv.integ).coeff (n + 1)).val = (F.coeff (n + 1)).val := by
  refine ⟨Q.val_zero, ?_⟩
  dsimp [integ, deriv]
  have hn_pos : 0 < n + 1 := Nat.succ_pos n
  have hn_num : (Q.ofNat (n + 1)).num ≠ 0 := by
    unfold Q.ofNat; exact Int.ofNat_ne_zero.mpr (ne_of_gt hn_pos)
  rw [Q.val_div _ _ hn_num, Q.val_mul, Q.val_ofNat]
  have hn_rat : ((n + 1 : Nat) : Rat) ≠ 0 := by exact_mod_cast (ne_of_gt hn_pos)
  exact mul_div_cancel_left₀ _ hn_rat

/-- **Theorem (Linearity of Jet Differentiation $\mathcal{D}(F + G) = \mathcal{D}F + \mathcal{D}G$)**: -/
theorem deriv_add_val (F G : Jet) (n : Nat) :
    (((F.add G).deriv).coeff n).val = ((F.deriv.add G.deriv).coeff n).val := by
  dsimp [deriv, add]
  rw [Q.val_mul, Q.val_add, Q.val_add, Q.val_mul, Q.val_mul]
  ring

/-- **Theorem (Linearity of Jet Integration $\mathcal{I}(F + G) = \mathcal{I}F + \mathcal{I}G$)**: -/
theorem integ_add_val (F G : Jet) (n : Nat) :
    (((F.add G).integ).coeff n).val = ((F.integ.add G.integ).coeff n).val := by
  cases n with
  | zero =>
    dsimp [integ, add]
    rw [Q.val_add]
    simp [Q.val_zero]
  | succ k =>
    dsimp [integ, add]
    have hk_pos : 0 < k + 1 := Nat.succ_pos k
    have hk_num : (Q.ofNat (k + 1)).num ≠ 0 := by
      unfold Q.ofNat; exact Int.ofNat_ne_zero.mpr (ne_of_gt hk_pos)
    rw [Q.val_div _ _ hk_num, Q.val_add, Q.val_add, Q.val_div _ _ hk_num, Q.val_div _ _ hk_num]
    ring

/-- **Theorem (Exponential Differential Equation Inside $\mathcal{U}_{\mathbb{Q}}$: $\mathcal{D}(\exp) = \exp$)**: -/
theorem exp_deriv_val (n : Nat) :
    ((Jet.exp.deriv).coeff n).val = (Jet.exp.coeff n).val := by
  dsimp [deriv, exp]
  have hf_succ : 0 < fact (n + 1) := fact_pos (n + 1)
  have hf_n : 0 < fact n := fact_pos n
  have hnum_succ : (Q.ofNat (fact (n + 1))).num ≠ 0 := by
    unfold Q.ofNat; exact Int.ofNat_ne_zero.mpr (ne_of_gt hf_succ)
  have hnum_n : (Q.ofNat (fact n)).num ≠ 0 := by
    unfold Q.ofNat; exact Int.ofNat_ne_zero.mpr (ne_of_gt hf_n)
  rw [Q.val_mul, Q.val_div _ _ hnum_succ, Q.val_div _ _ hnum_n]
  simp only [Q.val_ofNat]
  have hfact_eq : ((fact (n + 1) : Nat) : Rat) = ((n + 1 : Nat) : Rat) * (fact n : Rat) := by
    dsimp [fact]; push_cast; ring
  rw [hfact_eq]
  have hn_ne : ((n + 1 : Nat) : Rat) ≠ 0 := by positivity
  have hfn_ne : ((fact n : Nat) : Rat) ≠ 0 := by exact_mod_cast (ne_of_gt hf_n)
  field_simp

/-- **Theorem (Harmonic Differential Equations Inside $\mathcal{U}_{\mathbb{Q}}$:
    $\mathcal{D}(\sin) = \cos$ and $\mathcal{D}(\cos) = -\sin$)**: -/
theorem sin_cos_deriv_val (n : Nat) :
    ((Jet.sin.deriv).coeff n).val = (Jet.cos.coeff n).val ∧
    ((Jet.cos.deriv).coeff n).val = ((Jet.sin.neg).coeff n).val := by
  dsimp [deriv, sin, cos, neg, sinCosCoeffs]
  have hn_pos : 0 < n + 1 := Nat.succ_pos n
  have hn_num : (Q.ofNat (n + 1)).num ≠ 0 := by
    unfold Q.ofNat; exact Int.ofNat_ne_zero.mpr (ne_of_gt hn_pos)
  have hn_rat : ((n + 1 : Nat) : Rat) ≠ 0 := by exact_mod_cast (ne_of_gt hn_pos)
  refine ⟨?_, ?_⟩
  · rw [Q.val_mul, Q.val_div _ _ hn_num, Q.val_ofNat]
    exact mul_div_cancel₀ _ hn_rat
  · rw [Q.val_mul, Q.val_div _ _ hn_num, Q.val_ofNat]
    exact mul_div_cancel₀ _ hn_rat

end Jet

/-! ## 5. The Cauchy-Majorized Closed Universe (`AnalyticJet`) & Master Closure Theorem -/

/-- **An inhabitant of the Closed Numerical Universe $\mathcal{U}_{\mathbb{Q}}$ (`AnalyticJet`)**:
    A rational Taylor-jet stream `coeff : Nat → Q` equipped with a factorial-scaled
    Cauchy majorant $(M, R) \in \mathbb{N}^2$ certifying:
    $$|(coeff\; n).\mathrm{val}| \cdot n! \le 2^M \cdot (2^R)^n.$$
    Under this majorant, differentiation shifts $(M, R) \mapsto (M + R, R)$ and integration
    preserves $(M, R) \mapsto (M, R)$, making $\mathcal{U}_{\mathbb{Q}}$ **strictly closed**
    under arbitrary chains of $+, -, \mathcal{D}, \mathcal{I}$! -/
structure AnalyticJet extends Jet where
  /-- Majorant amplitude exponent $M$ ($2^M$). -/
  M : Nat
  /-- Majorant radius/growth exponent $R$ ($2^R$). -/
  R : Nat
  /-- Factorial-scaled Cauchy majorant certificate in `Q`'s own order `Q.ltN` (axiom-free):
      $|c_n| \cdot n! \le 2^M \cdot (2^R)^n$. -/
  majorant : ∀ n : Nat,
    Q.ltN (Q.ofNat (2 ^ M * (2 ^ R) ^ n))
          (Q.mul (Q.abs (coeff n)) (Q.ofNat (fact n))) = 0

namespace AnalyticJet

/-- Bridge between `Q`'s native `Q.ltN` majorant bound and `Rat` (`Q.val`). -/
theorem majorant_iff_val (q : Q) (M R n : Nat) :
    Q.ltN (Q.ofNat (2 ^ M * (2 ^ R) ^ n))
          (Q.mul (Q.abs q) (Q.ofNat (fact n))) = 0 ↔
      |q.val| * (fact n : Rat) ≤ (2 : Rat) ^ M * ((2 : Rat) ^ R) ^ n := by
  rw [Q.ltN_eq_zero_iff, Q.val_mul, Q.val_abs, Q.val_ofNat, Q.val_ofNat]
  push_cast
  rfl

/-- Value-level projection of `F.majorant`. -/
theorem majorant_val (F : AnalyticJet) (n : Nat) :
    |(F.coeff n).val| * (fact n : Rat) ≤ (2 : Rat) ^ F.M * ((2 : Rat) ^ F.R) ^ n :=
  (majorant_iff_val (F.coeff n) F.M F.R n).mp (F.majorant n)

/-- The zero function $0 \in \mathcal{U}_{\mathbb{Q}}$. -/
def zero : AnalyticJet where
  toJet := Jet.zero
  M := 0
  R := 0
  majorant := by
    intro n
    rw [majorant_iff_val]
    cases n with
    | zero =>
      dsimp [Jet.zero, Jet.const]
      simp [Q.val_zero]
    | succ k =>
      dsimp [Jet.zero, Jet.const]
      simp [Q.val_zero]

/-- The coordinate function $x \in \mathcal{U}_{\mathbb{Q}}$ ($M = 0, R = 0$). -/
def varX : AnalyticJet where
  toJet := Jet.varX
  M := 0
  R := 0
  majorant := by
    intro n
    rw [majorant_iff_val]
    rcases n with _ | _ | k
    · dsimp [Jet.varX]; simp [Q.val_zero]
    · dsimp [Jet.varX, fact]; rw [Q.val_ofNat]; norm_num
    · dsimp [Jet.varX]; simp [Q.val_zero]

/-- **Exponential Function $\exp(x) \in \mathcal{U}_{\mathbb{Q}}$** ($M = 0, R = 0$):
    Since $c_n = 1/n!$, we have $|c_n| \cdot n! = 1 \le 2^0 \cdot (2^0)^n$. -/
def exp : AnalyticJet where
  toJet := Jet.exp
  M := 0
  R := 0
  majorant := by
    intro n
    rw [majorant_iff_val]
    dsimp [Jet.exp]
    have hf_pos : 0 < fact n := fact_pos n
    have hf_num : (Q.ofNat (fact n)).num ≠ 0 := by
      unfold Q.ofNat; exact Int.ofNat_ne_zero.mpr (ne_of_gt hf_pos)
    rw [Q.val_div _ _ hf_num, Q.val_ofNat, Q.val_ofNat]
    have hf_rat_pos : (0 : Rat) < (fact n : Rat) := by exact_mod_cast hf_pos
    rw [abs_of_pos (div_pos (by norm_num) hf_rat_pos)]
    rw [div_mul_cancel₀ _ (ne_of_gt hf_rat_pos)]
    norm_num

/-- Bound on coupled $(\sin, \cos)$ Taylor coefficients:
    $\max(|s_n|, |c_n|) \cdot n! \le 1$. -/
theorem sinCosCoeffs_bound (n : Nat) :
    |((Jet.sinCosCoeffs n).1).val| * (fact n : Rat) ≤ 1 ∧
    |((Jet.sinCosCoeffs n).2).val| * (fact n : Rat) ≤ 1 := by
  induction n with
  | zero =>
    dsimp [Jet.sinCosCoeffs, fact]
    rw [Q.val_zero, Q.val_ofNat]
    norm_num
  | succ k ih =>
    dsimp [Jet.sinCosCoeffs]
    have hk_pos : 0 < k + 1 := Nat.succ_pos k
    have hk_num : (Q.ofNat (k + 1)).num ≠ 0 := by
      unfold Q.ofNat; exact Int.ofNat_ne_zero.mpr (ne_of_gt hk_pos)
    have hk_rat_pos : (0 : Rat) < ((k + 1 : Nat) : Rat) := by exact_mod_cast hk_pos
    have hfact_succ : (fact (k + 1) : Rat) = ((k + 1 : Nat) : Rat) * (fact k : Rat) := by
      dsimp [fact]; push_cast; ring
    refine ⟨?_, ?_⟩
    · rw [Q.val_div _ _ hk_num, Q.val_ofNat, abs_div, abs_of_pos hk_rat_pos, hfact_succ]
      have h_cancel : |((Jet.sinCosCoeffs k).2).val| / ((k + 1 : Nat) : Rat) *
          (((k + 1 : Nat) : Rat) * (fact k : Rat))
          = |((Jet.sinCosCoeffs k).2).val| * (fact k : Rat) := by
        field_simp
      rw [h_cancel]
      exact ih.2
    · rw [Q.val_div _ _ hk_num, Q.val_neg, Q.val_ofNat, abs_div, abs_neg,
          abs_of_pos hk_rat_pos, hfact_succ]
      have h_cancel : |((Jet.sinCosCoeffs k).1).val| / ((k + 1 : Nat) : Rat) *
          (((k + 1 : Nat) : Rat) * (fact k : Rat))
          = |((Jet.sinCosCoeffs k).1).val| * (fact k : Rat) := by
        field_simp
      rw [h_cancel]
      exact ih.1

/-- **Sine Function $\sin(x) \in \mathcal{U}_{\mathbb{Q}}$** ($M = 0, R = 0$). -/
def sin : AnalyticJet where
  toJet := Jet.sin
  M := 0
  R := 0
  majorant := by
    intro n
    rw [majorant_iff_val]
    have h := (sinCosCoeffs_bound n).1
    simpa [Jet.sin] using h

/-- **Cosine Function $\cos(x) \in \mathcal{U}_{\mathbb{Q}}$** ($M = 0, R = 0$). -/
def cos : AnalyticJet where
  toJet := Jet.cos
  M := 0
  R := 0
  majorant := by
    intro n
    rw [majorant_iff_val]
    have h := (sinCosCoeffs_bound n).2
    simpa [Jet.cos] using h

/-- **Closure Under Negation (`AnalyticJet.neg`)**: preserves $(M, R)$. -/
def neg (F : AnalyticJet) : AnalyticJet where
  toJet := F.toJet.neg
  M := F.M
  R := F.R
  majorant := by
    intro n
    rw [majorant_iff_val]
    dsimp [Jet.neg]
    rw [Q.val_neg, abs_neg]
    exact F.majorant_val n

/-- **Closure Under Addition (`AnalyticJet.add`)**:
    Shifts majorant $(M_1, R_1), (M_2, R_2) \mapsto (\max(M_1, M_2) + 1, \max(R_1, R_2))$. -/
def add (F G : AnalyticJet) : AnalyticJet where
  toJet := F.toJet.add G.toJet
  M := max F.M G.M + 1
  R := max F.R G.R
  majorant := by
    intro n
    rw [majorant_iff_val]
    dsimp [Jet.add]
    rw [Q.val_add]
    have h_tri : |(F.coeff n).val + (G.coeff n).val| * (fact n : Rat)
        ≤ |(F.coeff n).val| * (fact n : Rat) + |(G.coeff n).val| * (fact n : Rat) := by
      have h_fn : (0 : Rat) ≤ (fact n : Rat) := by positivity
      nlinarith [abs_add_le (F.coeff n).val (G.coeff n).val]
    have hF := F.majorant_val n
    have hG := G.majorant_val n
    have hM1 : (2 : Rat) ^ F.M ≤ (2 : Rat) ^ (max F.M G.M) :=
      pow_le_pow_right₀ (by norm_num) (Nat.le_max_left F.M G.M)
    have hM2 : (2 : Rat) ^ G.M ≤ (2 : Rat) ^ (max F.M G.M) :=
      pow_le_pow_right₀ (by norm_num) (Nat.le_max_right F.M G.M)
    have hR1 : ((2 : Rat) ^ F.R) ^ n ≤ ((2 : Rat) ^ (max F.R G.R)) ^ n :=
      pow_le_pow_left₀ (by positivity) (pow_le_pow_right₀ (by norm_num) (Nat.le_max_left F.R G.R)) n
    have hR2 : ((2 : Rat) ^ G.R) ^ n ≤ ((2 : Rat) ^ (max F.R G.R)) ^ n :=
      pow_le_pow_left₀ (by positivity) (pow_le_pow_right₀ (by norm_num) (Nat.le_max_right F.R G.R)) n
    have hF_dom : (2 : Rat) ^ F.M * ((2 : Rat) ^ F.R) ^ n
        ≤ (2 : Rat) ^ (max F.M G.M) * ((2 : Rat) ^ (max F.R G.R)) ^ n :=
      mul_le_mul hM1 hR1 (by positivity) (by positivity)
    have hG_dom : (2 : Rat) ^ G.M * ((2 : Rat) ^ G.R) ^ n
        ≤ (2 : Rat) ^ (max F.M G.M) * ((2 : Rat) ^ (max F.R G.R)) ^ n :=
      mul_le_mul hM2 hR2 (by positivity) (by positivity)
    have h_pow_succ : (2 : Rat) ^ (max F.M G.M + 1) = 2 * (2 : Rat) ^ (max F.M G.M) := by
      rw [pow_succ]; ring
    rw [h_pow_succ]
    linarith

/-- **Closure Under Subtraction (`AnalyticJet.sub`)**: -/
def sub (F G : AnalyticJet) : AnalyticJet where
  toJet := F.toJet.sub G.toJet
  M := max F.M G.M + 1
  R := max F.R G.R
  majorant := by
    intro n
    rw [majorant_iff_val]
    dsimp [Jet.sub]
    rw [Q.val_sub, sub_eq_add_neg]
    have h_add := (F.add G.neg).majorant_val n
    dsimp [add, neg, Jet.add, Jet.neg] at h_add
    rw [Q.val_add, Q.val_neg] at h_add
    exact h_add

/-- **Master Closure Under Differentiation (`AnalyticJet.deriv`)**:
    Differentiating $F \in \mathcal{U}_{\mathbb{Q}}$ keeps $\mathcal{D}(F)$ inside $\mathcal{U}_{\mathbb{Q}}$
    with shifted majorant $(M, R) \mapsto (M + R, R)$! -/
def deriv (F : AnalyticJet) : AnalyticJet where
  toJet := F.toJet.deriv
  M := F.M + F.R
  R := F.R
  majorant := by
    intro n
    rw [majorant_iff_val]
    dsimp [Jet.deriv]
    rw [Q.val_mul, Q.val_ofNat, abs_mul]
    have hn_pos : (0 : Rat) < ((n + 1 : Nat) : Rat) := by positivity
    rw [abs_of_pos hn_pos]
    have h_fact : ((n + 1 : Nat) : Rat) * |(F.coeff (n + 1)).val| * (fact n : Rat)
        = |(F.coeff (n + 1)).val| * (fact (n + 1) : Rat) := by
      dsimp [fact]; push_cast; ring
    rw [h_fact]
    have hF := F.majorant_val (n + 1)
    have h_exp : (2 : Rat) ^ F.M * ((2 : Rat) ^ F.R) ^ (n + 1)
        = (2 : Rat) ^ (F.M + F.R) * ((2 : Rat) ^ F.R) ^ n := by
      rw [pow_add, pow_succ]
      ring
    linarith

/-- **Master Closure Under Integration (`AnalyticJet.integ`)**:
    Integrating $F \in \mathcal{U}_{\mathbb{Q}}$ keeps $\mathcal{I}(F)$ inside $\mathcal{U}_{\mathbb{Q}}$
    with the **exact same majorant** $(M, R) \mapsto (M, R)$! -/
def integ (F : AnalyticJet) : AnalyticJet where
  toJet := F.toJet.integ
  M := F.M
  R := F.R
  majorant := by
    intro n
    rw [majorant_iff_val]
    cases n with
    | zero =>
      dsimp [Jet.integ, fact]
      rw [Q.val_zero, abs_zero, zero_mul]
      positivity
    | succ k =>
      dsimp [Jet.integ]
      have hk_pos : 0 < k + 1 := Nat.succ_pos k
      have hk_num : (Q.ofNat (k + 1)).num ≠ 0 := by
        unfold Q.ofNat; exact Int.ofNat_ne_zero.mpr (ne_of_gt hk_pos)
      have hk_rat_pos : (0 : Rat) < ((k + 1 : Nat) : Rat) := by exact_mod_cast hk_pos
      rw [Q.val_div _ _ hk_num, Q.val_ofNat, abs_div, abs_of_pos hk_rat_pos]
      have h_fact : |(F.coeff k).val| / ((k + 1 : Nat) : Rat) * (fact (k + 1) : Rat)
          = |(F.coeff k).val| * (fact k : Rat) := by
        dsimp [fact]; push_cast; field_simp
      rw [h_fact]
      have hF := F.majorant_val k
      have hR_ge : (1 : Rat) ≤ (2 : Rat) ^ F.R := one_le_pow₀ (by norm_num)
      have h_pow_le : (2 : Rat) ^ F.M * ((2 : Rat) ^ F.R) ^ k
          ≤ (2 : Rat) ^ F.M * ((2 : Rat) ^ F.R) ^ (k + 1) := by
        rw [pow_succ]
        nlinarith [ show (0 : Rat) ≤ (2 : Rat) ^ F.M * ((2 : Rat) ^ F.R) ^ k by positivity ]
      linarith

/-- **Master Closure Theorem for $\mathcal{U}_{\mathbb{Q}}$ (`master_closure_ftc`)**:
    For every $F, G \in \mathcal{U}_{\mathbb{Q}}$, their sum $F + G$, difference $F - G$,
    derivative $\mathcal{D}(F)$, and integral $\mathcal{I}(F)$ all remain inside $\mathcal{U}_{\mathbb{Q}}$,
    and satisfy the exact Newton–Leibniz identity $\mathcal{D}(\mathcal{I}(F)) = F$. -/
theorem master_closure_ftc (F : AnalyticJet) (n : Nat) :
    ((F.integ.deriv).coeff n).val = (F.coeff n).val ∧
    Q.ltN (Q.ofNat (2 ^ (F.M + F.R) * (2 ^ F.R) ^ n))
          (Q.mul (Q.abs (F.deriv.coeff n)) (Q.ofNat (fact n))) = 0 ∧
    Q.ltN (Q.ofNat (2 ^ F.M * (2 ^ F.R) ^ n))
          (Q.mul (Q.abs (F.integ.coeff n)) (Q.ofNat (fact n))) = 0 :=
  ⟨F.toJet.deriv_integ_val n, F.deriv.majorant n, F.integ.majorant n⟩

end AnalyticJet

/-! ## 5b. Lookahead Asymmetry, Baire Contraction of `tmJetInteg`, Guarded Picard Locking, and Kleene–Kreisel Continuity (`Continuity.lean`) -/

/-- **Prefix Agreement on Jet Streams (`JetAgree`)**:
    Two coefficient streams `c₁, c₂ : Nat → Q` agree on their first `n` coefficients ($0 \le i < n$).
    In the 2-adic Baire metric $d(c_1, c_2) = 2^{-\min\{i \mid c_1(i) \ne c_2(i)\}}$,
    `JetAgree n c₁ c₂` is the open/closed ball $d(c_1, c_2) \le 2^{-n}$. -/
def JetAgree (n : Nat) (c₁ c₂ : Nat → Q) : Prop :=
  ∀ i < n, c₁ i = c₂ i

theorem jetAgree_zero (c₁ c₂ : Nat → Q) : JetAgree 0 c₁ c₂ :=
  fun _ hi ↦ absurd hi (Nat.not_lt_zero _)

theorem jetAgree_mono {m n : Nat} (hmn : m ≤ n) {c₁ c₂ : Nat → Q}
    (h : JetAgree n c₁ c₂) : JetAgree m c₁ c₂ :=
  fun i hi ↦ h i (Nat.lt_of_lt_of_le hi hmn)

/-- Pointwise evaluation formula for `tmJetDeriv`. -/
theorem tmJetDeriv_eval (c : Nat → Q) (n : Nat) :
    (((tmJetDeriv (Γ := [])).eval Env.nil) c) n = Q.mul (Q.ofNat (n + 1)) (c (n + 1)) :=
  rfl

/-- Pointwise evaluation formula for `tmJetInteg` at $n = 0$ ($0$ queries to $c$!). -/
theorem tmJetInteg_eval_zero (c : Nat → Q) :
    (((tmJetInteg (Γ := [])).eval Env.nil) c) 0 = Q.zero :=
  rfl

/-- Pointwise evaluation formula for `tmJetInteg` at $n + 1$ (queries $c$ only at index $n < n + 1$!). -/
theorem tmJetInteg_eval_succ (c : Nat → Q) (n : Nat) :
    (((tmJetInteg (Γ := [])).eval Env.nil) c) (n + 1) = Q.div (c n) (Q.ofNat (n + 1)) :=
  rfl

/-- **Lookahead $0$ (Synchronous) for `tmJetAdd`**:
    Output coefficients $< n$ depend only on input coefficients $< n$. -/
theorem tmJetAdd_lookahead_zero (n : Nat) (a₁ a₂ b₁ b₂ : Nat → Q)
    (ha : JetAgree n a₁ a₂) (hb : JetAgree n b₁ b₂) :
    JetAgree n ((((tmJetAdd (Γ := [])).eval Env.nil) a₁) b₁)
               ((((tmJetAdd (Γ := [])).eval Env.nil) a₂) b₂) := by
  intro i hi
  show Q.add (a₁ i) (b₁ i) = Q.add (a₂ i) (b₂ i)
  rw [ha i hi, hb i hi]

/-- **Lookahead $0$ (Synchronous) for `tmJetSub`**:
    Output coefficients $< n$ depend only on input coefficients $< n$. -/
theorem tmJetSub_lookahead_zero (n : Nat) (a₁ a₂ b₁ b₂ : Nat → Q)
    (ha : JetAgree n a₁ a₂) (hb : JetAgree n b₁ b₂) :
    JetAgree n ((((tmJetSub (Γ := [])).eval Env.nil) a₁) b₁)
               ((((tmJetSub (Γ := [])).eval Env.nil) a₂) b₂) := by
  intro i hi
  show Q.sub (a₁ i) (b₁ i) = Q.sub (a₂ i) (b₂ i)
  rw [ha i hi, hb i hi]

/-- **Lookahead $+1$ for Differentiation (`tmJetDeriv_lookahead_plus_one`)**:
    To determine the first $n$ coefficients of $\mathcal{D}(c)$, it suffices that $c_1$ and $c_2$
    agree on their first $n + 1$ coefficients (`JetAgree (n + 1) c₁ c₂ → JetAgree n (D c₁) (D c₂)`). -/
theorem tmJetDeriv_lookahead_plus_one (n : Nat) (c₁ c₂ : Nat → Q)
    (h : JetAgree (n + 1) c₁ c₂) :
    JetAgree n (((tmJetDeriv (Γ := [])).eval Env.nil) c₁)
               (((tmJetDeriv (Γ := [])).eval Env.nil) c₂) := by
  intro i hi
  rw [tmJetDeriv_eval, tmJetDeriv_eval, h (i + 1) (Nat.succ_lt_succ hi)]

/-- **Lookahead $-1$ / Strict Causality / Baire $\frac{1}{2}$-Contraction for Integration (`tmJetInteg_contractive_minus_one`)**:
    `tmJetInteg`'s output at index $i$ depends ONLY on input at index $i - 1 < i$ (and at $i = 0$ on no input at all).
    Consequently, if $c_1$ and $c_2$ agree on $< n$ (`JetAgree n c₁ c₂`), their integrals agree on $< n + 1$
    (`JetAgree (n + 1) (I c₁) (I c₂)`), contracting Baire distance $2^{-n} \mapsto 2^{-(n+1)} = \frac{1}{2} \cdot 2^{-n}$! -/
theorem tmJetInteg_contractive_minus_one (n : Nat) (c₁ c₂ : Nat → Q)
    (h : JetAgree n c₁ c₂) :
    JetAgree (n + 1) (((tmJetInteg (Γ := [])).eval Env.nil) c₁)
                     (((tmJetInteg (Γ := [])).eval Env.nil) c₂) := by
  intro i hi
  cases i with
  | zero => rfl
  | succ k =>
    rw [tmJetInteg_eval_succ, tmJetInteg_eval_succ, h k (Nat.lt_of_succ_lt_succ hi)]

/-- The extracted antiderivative functional `extractedJetInteg` is likewise strictly causal (`JetAgree n → JetAgree (n + 1)`). -/
theorem extractedJetInteg_contractive_minus_one (n : Nat) (c₁ c₂ : Nat → Q)
    (h : JetAgree n c₁ c₂) :
    JetAgree (n + 1) (extractedJetInteg c₁) (extractedJetInteg c₂) :=
  tmJetInteg_contractive_minus_one n c₁ c₂ h

/-- **Guarded Picard Coefficient-Locking Theorem (`picard_jetAgree_lock`)**:
    For any synchronous/causal vector field $\Phi : (\mathbb{N} \to Q) \to (\mathbb{N} \to Q)$
    satisfying $\forall n\, u\, v,\; \mathrm{JetAgree}\; n\; u\; v \to \mathrm{JetAgree}\; n\; (\Phi\, u)\; (\Phi\, v)$
    and any initial-condition jet $y_0 : \mathbb{N} \to Q$, the System T Picard operator
    $$\mathcal{P}(y) := \mathrm{tmJetAdd}\; y_0\; (\mathrm{tmJetInteg}\; (\Phi\, y))$$
    is a strict Baire contraction (`JetAgree n → JetAgree (n + 1)`), so **$k$ iterations lock the first $k$
    Taylor coefficients independent of the starting streams $u, v$**:
    $$\forall k \in \mathbb{N},\; \forall u\, v : \mathbb{N} \to Q,\quad \mathrm{JetAgree}\; k\; (\mathcal{P}^{[k]}\, u)\; (\mathcal{P}^{[k]}\, v).$$ -/
def sysTPicardStep (y₀ : Nat → Q) (Φ : (Nat → Q) → (Nat → Q)) (y : Nat → Q) : Nat → Q :=
  (((tmJetAdd (Γ := [])).eval Env.nil) y₀) ((((tmJetInteg (Γ := [])).eval Env.nil) (Φ y)))

theorem sysTPicardStep_contractive (y₀ : Nat → Q) (Φ : (Nat → Q) → (Nat → Q))
    (hΦ : ∀ n u v, JetAgree n u v → JetAgree n (Φ u) (Φ v))
    (n : Nat) (u v : Nat → Q) (h : JetAgree n u v) :
    JetAgree (n + 1) (sysTPicardStep y₀ Φ u) (sysTPicardStep y₀ Φ v) :=
  tmJetAdd_lookahead_zero (n + 1) y₀ y₀ _ _
    (fun _ _ ↦ rfl)
    (tmJetInteg_contractive_minus_one n (Φ u) (Φ v) (hΦ n u v h))

theorem picard_jetAgree_lock (y₀ : Nat → Q) (Φ : (Nat → Q) → (Nat → Q))
    (hΦ : ∀ n u v, JetAgree n u v → JetAgree n (Φ u) (Φ v))
    (k : Nat) (u v : Nat → Q) :
    JetAgree k ((sysTPicardStep y₀ Φ)^[k] u) ((sysTPicardStep y₀ Φ)^[k] v) := by
  induction k generalizing u v with
  | zero => exact jetAgree_zero _ _
  | succ m ihm =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
    exact sysTPicardStep_contractive y₀ Φ hΦ m _ _ (ihm u v)

/-- **Kleene–Kreisel Continuity Bridge (`Continuity.lean`)**:
    Every closed System T calculus combinator (`tmJetDeriv`, `tmJetInteg`, `tmJetAdd`, `tmJetSub`)
    and every extracted realizer (`ftcAntiderivD`) is `Tracked` in the Kleene–Kreisel logical relation,
    so evaluating any output coefficient on a `Tracked JetTy` oracle family is continuous (`ContAt Q`). -/
theorem tmJetDeriv_tracked :
    Tracked (.arrow JetTy JetTy) (fun _ ↦ (tmJetDeriv (Γ := [])).eval Env.nil) :=
  eval_tracked (tmJetDeriv (Γ := [])) (fun _ ↦ Env.nil) (fun _ v ↦ nomatch v)

theorem tmJetInteg_tracked :
    Tracked (.arrow JetTy JetTy) (fun _ ↦ (tmJetInteg (Γ := [])).eval Env.nil) :=
  eval_tracked (tmJetInteg (Γ := [])) (fun _ ↦ Env.nil) (fun _ v ↦ nomatch v)

theorem ftcAntideriv_tracked :
    Tracked (.arrow JetTy (.prod JetTy (.prod .unit (.arrow .nat .unit))))
      (fun _ ↦ (extractClosed ftcAntiderivD).eval Env.nil) :=
  extract_tracked ftcAntiderivD

theorem tmJetInteg_contAt_coeff {C : (ℕ → ℕ) → (ℕ → Q)} (hC : Tracked JetTy C) (n : ℕ) :
    ContAt Q (fun α ↦ (((tmJetInteg (Γ := [])).eval Env.nil) (C α)) n) :=
  tmJetInteg_tracked C hC (fun _ ↦ n) (continuous2_const n)

theorem tmJetDeriv_contAt_coeff {C : (ℕ → ℕ) → (ℕ → Q)} (hC : Tracked JetTy C) (n : ℕ) :
    ContAt Q (fun α ↦ (((tmJetDeriv (Γ := [])).eval Env.nil) (C α)) n) :=
  tmJetDeriv_tracked C hC (fun _ ↦ n) (continuous2_const n)

/-! ## 6. Kernel `#guard` Verification of the System T Functionals & Closed Ring -/

-- 1. Order-0 System T Exponential Jet (`tmExpJet`): generates [1, 1, 1/2, 1/6, 1/24, 1/120]
#guard (List.range 6).map ((tmExpJet (Γ := [])).eval Env.nil)
  == [Q.ofNat 1, Q.ofNat 1, Q.of 1 2, Q.of 1 6, Q.of 1 24, Q.of 1 120]

-- 2. Order-0 System T Sine & Cosine Jets (`tmSinJet`, `tmCosJet`):
-- sin(x) = 0 + 1*x + 0*x² - 1/6*x³ + 0*x⁴ + 1/120*x⁵
#guard (List.range 6).map ((tmSinJet (Γ := [])).eval Env.nil)
  == [Q.zero, Q.ofNat 1, Q.zero, Q.of (-1) 6, Q.zero, Q.of 1 120]

-- cos(x) = 1 + 0*x - 1/2*x² + 0*x³ + 1/24*x⁴ + 0*x⁵
#guard (List.range 6).map ((tmCosJet (Γ := [])).eval Env.nil)
  == [Q.ofNat 1, Q.zero, Q.of (-1) 2, Q.zero, Q.of 1 24, Q.zero]

-- 3. System T Differentiation Functional `tmJetDeriv` applied to `tmSinJet` gives `tmCosJet`:
#guard (List.range 5).map (((tmJetDeriv (Γ := [])).eval Env.nil) ((tmSinJet (Γ := [])).eval Env.nil))
  == (List.range 5).map ((tmCosJet (Γ := [])).eval Env.nil)

-- 4. System T Differentiation Functional `tmJetDeriv` applied to `tmExpJet` gives `tmExpJet`:
#guard (List.range 5).map (((tmJetDeriv (Γ := [])).eval Env.nil) ((tmExpJet (Γ := [])).eval Env.nil))
  == (List.range 5).map ((tmExpJet (Γ := [])).eval Env.nil)

-- 5. Extracted Antiderivative Functional `extractedJetInteg` (from `extractClosed ftcAntiderivD`):
-- Integrating cos(x) gives sin(x) on the nose!
#guard (List.range 6).map (extractedJetInteg ((tmCosJet (Γ := [])).eval Env.nil))
  == (List.range 6).map ((tmSinJet (Γ := [])).eval Env.nil)

-- 6. FTC1 Round-Trip in System T: `tmJetDeriv (extractedJetInteg exp) = exp`:
#guard (List.range 5).map (((tmJetDeriv (Γ := [])).eval Env.nil) (extractedJetInteg ((tmExpJet (Γ := [])).eval Env.nil)))
  == (List.range 5).map ((tmExpJet (Γ := [])).eval Env.nil)

